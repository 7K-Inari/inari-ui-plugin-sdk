{
  "name": "@7k-inari/ui-plugin-sdk",
  "version": "0.1.3",
  "description": "TypeScript SDK for Inari UI extensions: extension-point blueprints, host APIs, dev harness",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js",
      "require": "./dist/tokens/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.cjs"
    },
    "./harness": {
      "types": "./dist/harness/index.d.ts",
      "import": "./dist/harness/index.js",
      "require": "./dist/harness/index.cjs"
    },
    "./tokens.css": "./src/tokens/tokens.css"
  },
  "bin": {
    "inari-ui-ext": "./bin/inari-ui-ext.mjs",
    "create-inari-ui-extension": "./bin/create-inari-ui-extension.mjs"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "harness/shell",
    "src/tokens/tokens.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "zod": ">=3"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.8.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.13.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.3",
    "zod": "^3.23.8"
  }
}